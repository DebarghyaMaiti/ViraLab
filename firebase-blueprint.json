{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile information and app preferences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sign-in timestamp"
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "SavedSimulation": {
      "title": "SavedSimulation",
      "description": "User-saved simulation configuration with calibrated parameter sets",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique simulation configuration ID"
        },
        "userId": {
          "type": "string",
          "description": "Author UID"
        },
        "name": {
          "type": "string",
          "description": "Simulation title"
        },
        "description": {
          "type": "string",
          "description": "Optional notes or hypothesis"
        },
        "config": {
          "type": "object",
          "description": "Complete SEIRD simulation configuration JSON"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Created timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "name", "config", "createdAt"]
    },
    "SimulationLog": {
      "title": "SimulationLog",
      "description": "Historical execution log of a completed simulation run with outcomes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log entry ID"
        },
        "userId": {
          "type": "string",
          "description": "User UID who executed run"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Execution timestamp"
        },
        "label": {
          "type": "string",
          "description": "User or generated label"
        },
        "solver": {
          "type": "string",
          "description": "Numerical solver used"
        },
        "mode": {
          "type": "string",
          "description": "Deterministic or stochastic mode"
        },
        "config": {
          "type": "object",
          "description": "Simulation parameters snapshot"
        },
        "parametersSummary": {
          "type": "object",
          "description": "Summary of primary epidemiological parameters"
        },
        "outcomesSummary": {
          "type": "object",
          "description": "Epidemiological KPI outcomes"
        },
        "transitions": {
          "type": "array",
          "description": "Key state transition events"
        }
      },
      "required": ["id", "userId", "timestamp", "label", "solver", "config", "parametersSummary", "outcomesSummary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User root document with profile and account settings"
    },
    "/users/{userId}/saved_simulations/{simulationId}": {
      "schema": {
        "$ref": "#/entities/SavedSimulation"
      },
      "description": "User's saved simulation setups and scenario configs"
    },
    "/users/{userId}/simulation_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/SimulationLog"
      },
      "description": "Historical simulation execution logs and comparative snapshots"
    }
  }
}
